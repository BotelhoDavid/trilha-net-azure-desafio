name: dockercompose10503690777342411744
services:
  azurite:
    command:
      - azurite
      - --blobHost
      - 0.0.0.0
      - --queueHost
      - 0.0.0.0
      - --tableHost
      - 0.0.0.0
    container_name: azurite
    image: mcr.microsoft.com/azure-storage/azurite
    networks:
      trilha-net-azure-desafio-network: null
    ports:
      - mode: ingress
        target: 10000
        published: "10000"
        protocol: tcp
      - mode: ingress
        target: 10001
        published: "10001"
        protocol: tcp
      - mode: ingress
        target: 10002
        published: "10002"
        protocol: tcp
    volumes:
      - type: volume
        source: azurite_data
        target: /data
        volume: {}
  sqlserver:
    container_name: sqlserver
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: Your_password123
    image: mcr.microsoft.com/mssql/server:2022-latest
    networks:
      trilha-net-azure-desafio-network: null
    ports:
      - mode: ingress
        target: 1433
        published: "1433"
        protocol: tcp
    volumes:
      - type: volume
        source: sql_data
        target: /var/opt/mssql
        volume: {}
  trilha-net-azure-desafio:
    build:
      context: C:\Users\david\Desktop\DIO\trilha-net-azure-desafio\src
      dockerfile: Dockerfile
    depends_on:
      azurite:
        condition: service_started
        required: true
      sqlserver:
        condition: service_started
        required: true
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ASPNETCORE_URLS: http://+:8080
      ConnectionStrings__AzureTableStorage: DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;TableEndpoint=http://azurite:10002/devstoreaccount1;
      ConnectionStrings__SqlServer: Server=sqlserver,1433;Database=Agendamento;User Id=sa;Password=Your_password123;
    image: trilhanetazuredesafio
    networks:
      trilha-net-azure-desafio-network: null
    ports:
      - mode: ingress
        target: 8080
        published: "5000"
        protocol: tcp
      - mode: ingress
        target: 8080
        protocol: tcp
      - mode: ingress
        target: 8081
        protocol: tcp
    volumes:
      - type: bind
        source: C:\Users\david\AppData\Roaming/Microsoft/UserSecrets
        target: /home/app/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\david\AppData\Roaming/Microsoft/UserSecrets
        target: /root/.microsoft/usersecrets
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\david\AppData\Roaming/ASP.NET/Https
        target: /home/app/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
      - type: bind
        source: C:\Users\david\AppData\Roaming/ASP.NET/Https
        target: /root/.aspnet/https
        read_only: true
        bind:
          create_host_path: true
networks:
  trilha-net-azure-desafio-network:
    name: dockercompose10503690777342411744_trilha-net-azure-desafio-network
    driver: bridge
volumes:
  azurite_data:
    name: dockercompose10503690777342411744_azurite_data
  sql_data:
    name: dockercompose10503690777342411744_sql_data